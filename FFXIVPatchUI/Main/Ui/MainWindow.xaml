                <Border x:Name="FontDependencyNote" Visibility="Collapsed" Background="#116AA7D4" BorderBrush="#739CBF" BorderThickness="2,0,0,0" Padding="9,7" Margin="0,8,6,0"><TextBlock x:Name="FontDependencyText" Foreground="#B9D9F1" FontSize="11" TextWrapping="Wrap"/></Border>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="13,10"><StackPanel>
              <DockPanel><TextBlock x:Name="PreflightIcon" Text="●" Foreground="{StaticResource TextDim}" FontWeight="Bold" Width="20" VerticalAlignment="Center"/><Button x:Name="PreflightRunButton" DockPanel.Dock="Right" Style="{StaticResource SubButton}" Content="다시 점검"/><TextBlock x:Name="PreflightSummary" Text="사전 점검 대기 중" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DockPanel>
              <ToggleButton x:Name="PreflightToggle" Style="{StaticResource TextToggle}" Content="점검 항목 보기" FontSize="11" Margin="0,7,0,0" HorizontalAlignment="Left"/>
              <StackPanel x:Name="PreflightPanel" Visibility="Collapsed" Margin="0,9,0,0"><ItemsControl x:Name="PreflightList" ItemTemplate="{StaticResource PreflightItemTemplate}"/><DockPanel Margin="2,8,0,0"><Button x:Name="PreflightLogButton" DockPanel.Dock="Right" Style="{StaticResource SubButton}" Content="로그 열기"/><ToggleButton x:Name="PreflightShowAllToggle" DockPanel.Dock="Left" Style="{StaticResource TextToggle}" Content="전체 항목 보기" FontSize="11" Margin="0,0,12,0"/><TextBlock x:Name="PreflightLogPath" Foreground="{StaticResource TextDim}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/></DockPanel></StackPanel>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="13,10"><StackPanel><ToggleButton x:Name="AdvancedToggle" AutomationProperties.AutomationId="AdvancedToggle" Style="{StaticResource TextToggle}" Content="고급 기능 · 백업 복구 · 폴더 · 정리" FontSize="11" HorizontalAlignment="Left"/><StackPanel x:Name="AdvancedPanel" Visibility="Collapsed" Margin="0,10,0,2"><WrapPanel><Button x:Name="RestoreBackupButton" Style="{StaticResource SubButton}" Content="백업으로 복구" Margin="0,0,7,7"/><Button x:Name="OpenReleaseButton" Style="{StaticResource SubButton}" Content="생성 폴더" Margin="0,0,7,7"/><Button x:Name="OpenLogsButton" Style="{StaticResource SubButton}" Content="로그 폴더" Margin="0,0,7,7"/><Button x:Name="CleanupButton" Style="{StaticResource SubButton}" Content="오래된 파일 정리" Margin="0,0,7,7"/></WrapPanel><DockPanel x:Name="FontProfileRow" Visibility="Collapsed" Margin="0,2,0,0"><TextBlock Text="테스트 폰트 프로필" Foreground="{StaticResource TextDim}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/><ComboBox x:Name="FontProfileCombo" Style="{StaticResource DarkCombo}" Width="210" Height="30" HorizontalAlignment="Left"/></DockPanel></StackPanel></StackPanel></Border>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <Border Grid.Row="2" x:Name="ActionDock" AutomationProperties.AutomationId="ActionDock" Background="#121620" BorderBrush="#3E475B" BorderThickness="0,1,0,0" Padding="18,12,18,10">
        <StackPanel>
          <Border x:Name="GuardNote" Visibility="Collapsed" Background="#13D4AF6A" BorderBrush="#80693F" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10"><TextBlock x:Name="GuardNoteText" Foreground="#EFD29A" FontSize="11" TextWrapping="Wrap"/></Border>
          <Grid x:Name="ApplyGrid"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="194"/><ColumnDefinition Width="128"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel x:Name="SelectionSummaryPanel" VerticalAlignment="Center" Margin="0,0,14,0"><TextBlock Text="다음 적용 구성" Foreground="{StaticResource TextDim}" FontSize="10.5"/><TextBlock x:Name="TextProfileSummary" AutomationProperties.AutomationId="TextProfileSummary" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="SelectionDetailText" AutomationProperties.AutomationId="SelectionDetailText" Foreground="{StaticResource TextDim}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel>
            <Button x:Name="FullPatchButton" AutomationProperties.AutomationId="FullPatchButton" Grid.Column="1" Style="{StaticResource ActionButton}" Content="선택 구성 패치" Tag="선택한 구성과 한글 폰트를 적용합니다"/>
            <Button x:Name="TestPatchButton" AutomationProperties.AutomationId="TestPatchButton" Grid.Column="1" Style="{StaticResource ActionButton}" Visibility="Collapsed" Content="선택 구성 테스트" Tag="실제 클라이언트는 변경하지 않고 debug-apply 폴더에 생성·적용합니다"/>
            <Button x:Name="RemoveButton" AutomationProperties.AutomationId="RemoveButton" Grid.Column="2" Style="{StaticResource RemoveActionButton}" Content="패치 제거" Margin="12,0,0,0" ToolTip="패치를 제거하고 원본 참조로 되돌립니다. 실행 전에 확인합니다."/>
          </Grid>
          <DockPanel Margin="0,8,0,0"><TextBlock x:Name="SettingsSaveState" AutomationProperties.AutomationId="SettingsSaveState" DockPanel.Dock="Right" Text="선택 자동 저장" Foreground="{StaticResource TextDim}" FontSize="10.5" VerticalAlignment="Center"/><Button x:Name="FontPatchButton" Style="{StaticResource TextAction}" Content="폰트만 패치" Foreground="{StaticResource Blue}" HorizontalAlignment="Left" ToolTip="텍스트·UI 이미지는 원문으로 유지하고 한글 폰트만 적용"/></DockPanel>
          <Border BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,1,0,0" Padding="0,7,0,0" Margin="0,5,0,0"><DockPanel><TextBlock x:Name="FooterPercent" DockPanel.Dock="Right" Foreground="{StaticResource TextDim}" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"/><Button x:Name="OpenLastLogButton" DockPanel.Dock="Right" Style="{StaticResource TextAction}" Content="로그 보기" Foreground="{StaticResource TextDim}" MinHeight="20" Padding="0" Margin="8,0,0,0"/><TextBlock x:Name="FooterStatus" Foreground="{StaticResource TextDim}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DockPanel></Border>
          <Border x:Name="ProgressTrack" Height="4" CornerRadius="2" Background="{StaticResource Panel2Bg}" ClipToBounds="True" Margin="0,5,0,0"><Border x:Name="ProgressFill" Width="0" Height="4" CornerRadius="2" HorizontalAlignment="Left" Background="{StaticResource Gold}"><Border.RenderTransform><TranslateTransform x:Name="ProgressMarqueeTransform" X="0"/></Border.RenderTransform></Border></Border>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
