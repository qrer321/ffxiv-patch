<!-- Loose XAML loaded through XamlReader; events are wired in MainWindow.cs. -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FFXIV 한글 패치" Width="780" Height="940"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        FontFamily="Malgun Gothic, Segoe UI" FontSize="12" Foreground="#E8E6E1"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" SnapsToDevicePixels="True">
  <Window.Resources>
    <SolidColorBrush x:Key="WinBg" Color="#0E1016"/>
    <SolidColorBrush x:Key="PanelBg" Color="#151923"/>
    <SolidColorBrush x:Key="Panel2Bg" Color="#1A1F2B"/>
    <SolidColorBrush x:Key="BorderBrushMain" Color="#30384A"/>
    <SolidColorBrush x:Key="BorderBrushSoft" Color="#262C3A"/>
    <SolidColorBrush x:Key="TextMain" Color="#E8E6E1"/>
    <SolidColorBrush x:Key="TextDim" Color="#A6AFBF"/>
    <SolidColorBrush x:Key="TextFaint" Color="#A6AFBF"/>
    <SolidColorBrush x:Key="Gold" Color="#D4AF6A"/>
    <SolidColorBrush x:Key="GoldBright" Color="#F0D398"/>
    <SolidColorBrush x:Key="Blue" Color="#ABD5F5"/>
    <SolidColorBrush x:Key="Red" Color="#E69A92"/>
    <SolidColorBrush x:Key="Green" Color="#95D9A4"/>
    <SolidColorBrush x:Key="Amber" Color="#E0B85C"/>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource PanelBg}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="14,12"/>
    </Style>
    <Style x:Key="SubButton" TargetType="Button">
      <Setter Property="Foreground" Value="#C9D0DB"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{StaticResource Panel2Bg}" BorderBrush="{StaticResource BorderBrushMain}"
                    BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Gold}"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource GoldBright}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="#12161F"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="TextAction" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" Padding="2,3">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#16FFFFFF"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource GoldBright}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource SubButton}">
      <Setter Property="Foreground" Value="{StaticResource GoldBright}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="MinHeight" Value="44"/>
      <Setter Property="ToolTip" Value="{Binding Tag, RelativeSource={RelativeSource Self}}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" BorderBrush="#BDA16B" BorderThickness="1" CornerRadius="7" Padding="10,8">
              <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#30D4AF6A" Offset="0"/><GradientStop Color="#16D4AF6A" Offset="1"/></LinearGradientBrush></Border.Background>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#38D4AF6A"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource GoldBright}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="RemoveActionButton" TargetType="Button" BasedOn="{StaticResource SubButton}">
      <Setter Property="Foreground" Value="{StaticResource Red}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="MinHeight" Value="44"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="#21181D" BorderBrush="#9A615C"
                    BorderThickness="1" CornerRadius="7" Padding="10,8">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#342024"/><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Red}"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource GoldBright}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="#1B1418"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Chip" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#C9D0DB"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" Background="Transparent" BorderBrush="#475268" BorderThickness="1" CornerRadius="16" Padding="13,6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="Bd" Property="Background" Value="#21D4AF6A"/><Setter TargetName="Bd" Property="BorderBrush" Value="#A58850"/><Setter Property="Foreground" Value="{StaticResource GoldBright}"/></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Gold}"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource GoldBright}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.6"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ScopeOutcome" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#C9D0DB"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Width" Value="64"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" Background="Transparent" BorderBrush="#4A566D" BorderThickness="1" CornerRadius="5">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse x:Name="Dot" Width="6" Height="6" Stroke="{TemplateBinding Foreground}" Fill="Transparent" Margin="0,0,4,0" VerticalAlignment="Center"/>
                <ContentPresenter VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="Bd" Property="Background" Value="#352C1D"/><Setter TargetName="Bd" Property="BorderBrush" Value="#B39B67"/><Setter Property="Foreground" Value="{StaticResource GoldBright}"/><Setter TargetName="Dot" Property="Fill" Value="{StaticResource GoldBright}"/></Trigger>
              <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsChecked" Value="True"/><Condition Property="Tag" Value="base"/></MultiTrigger.Conditions><Setter TargetName="Bd" Property="Background" Value="#1C2C3B"/><Setter TargetName="Bd" Property="BorderBrush" Value="#739CBF"/><Setter Property="Foreground" Value="{StaticResource Blue}"/><Setter TargetName="Dot" Property="Fill" Value="{StaticResource Blue}"/></MultiTrigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#A5B2C7"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource GoldBright}"/><Setter TargetName="Bd" Property="BorderThickness" Value="2"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.6"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ScopeRow" TargetType="Border">
      <Setter Property="Background" Value="#10151E"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="7"/><Setter Property="Padding" Value="9,10"/><Setter Property="Margin" Value="0,0,6,6"/>
    </Style>
    <Style x:Key="ScopeLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="ScopeDescription" TargetType="TextBlock"><Setter Property="FontSize" Value="10.5"/><Setter Property="Foreground" Value="{StaticResource TextDim}"/><Setter Property="Margin" Value="0,3,0,0"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="TextToggle" TargetType="ToggleButton">
      <Setter Property="Foreground" Value="{StaticResource TextDim}"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="2"><StackPanel Orientation="Horizontal"><TextBlock x:Name="Arrow" Text="▸" Margin="0,0,7,0"/><ContentPresenter VerticalAlignment="Center"/></StackPanel></Border>
        <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="Text" Value="▾"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource TextMain}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource GoldBright}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="DarkComboItem" TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
        <Border x:Name="Bd" Background="Transparent" Padding="11,7" CornerRadius="6" Margin="3,1"><ContentPresenter/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Bd" Property="Background" Value="#24D4AF6A"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="DarkCombo" TargetType="ComboBox">
      <Setter Property="Foreground" Value="{StaticResource TextMain}"/><Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboItem}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
        <Grid>
          <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="Bd" Background="{StaticResource Panel2Bg}" BorderBrush="#475268" BorderThickness="1" CornerRadius="6"><TextBlock Text="▾" Foreground="{StaticResource TextDim}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Gold}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="9,0,25,0" VerticalAlignment="Center" IsHitTestVisible="False" TextElement.Foreground="{StaticResource TextMain}"/>
          <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" StaysOpen="False" VerticalOffset="4"><Border Background="#161B26" BorderBrush="{StaticResource BorderBrushMain}" BorderThickness="1" CornerRadius="8" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="240" Padding="0,3"><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer></Border></Popup>
        </Grid>
        <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.6"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="9"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="Transparent"><Track x:Name="PART_Track" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#6D7890" CornerRadius="4" Margin="1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb></Track></Grid></ControlTemplate></Setter.Value></Setter>
    </Style>
    <DataTemplate x:Key="PreflightItemTemplate"><Border Background="{StaticResource Panel2Bg}" CornerRadius="6" Padding="10,6" Margin="0,3,0,0"><DockPanel><TextBlock DockPanel.Dock="Left" Text="{Binding Icon}" Foreground="{Binding IconBrush}" FontWeight="Bold" Width="22"/><TextBlock Text="{Binding Text}" Foreground="#C9D0DB" TextWrapping="Wrap" FontSize="12"/></DockPanel></Border></DataTemplate>
  </Window.Resources>

  <Border CornerRadius="12" Background="{StaticResource WinBg}" BorderBrush="{StaticResource BorderBrushMain}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border x:Name="TitleBar" Grid.Row="0" Background="#0A0C11" CornerRadius="11,11,0,0" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,0,1" Padding="14,0">
        <DockPanel>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="18" Height="18" CornerRadius="4" Background="{StaticResource Gold}"><TextBlock Text="◆" Foreground="#161923" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="FFXIV 한글 패치" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" Margin="10,0,0,0"/><Border x:Name="ModeBadge" Visibility="Collapsed" BorderBrush="#80693F" BorderThickness="1" CornerRadius="8" Padding="6,1" Margin="10,0,0,0"><TextBlock Text="TEST BUILD" Foreground="{StaticResource Amber}" FontSize="10"/></Border></StackPanel>
          <Button x:Name="CloseButton" AutomationProperties.AutomationId="CloseButton" AutomationProperties.Name="창 닫기" DockPanel.Dock="Right" Style="{StaticResource TextAction}" Content="×" Foreground="{StaticResource TextDim}" Width="30" Margin="4,0,0,0" FontSize="18"/>
          <Button x:Name="MinButton" AutomationProperties.Name="최소화" DockPanel.Dock="Right" Style="{StaticResource TextAction}" Content="−" Foreground="{StaticResource TextDim}" Width="30" FontSize="16"/><Border/>
        </DockPanel>
      </Border>

      <ScrollViewer x:Name="MainScrollViewer" AutomationProperties.AutomationId="MainScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" PanningMode="VerticalOnly">
        <StackPanel>
          <Grid Height="62" ClipToBounds="True"><Image x:Name="BannerImage" Stretch="UniformToFill" VerticalAlignment="Center"/><Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#400E1016" Offset="0"/><GradientStop Color="#FF0E1016" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle></Grid>
          <StackPanel Margin="18,0,18,16">
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Ellipse x:Name="StateDot" Width="8" Height="8" Fill="{StaticResource TextDim}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <StackPanel Grid.Column="1"><TextBlock Text="현재 적용 상태" Foreground="{StaticResource TextDim}" FontSize="10.5" Margin="0,0,0,3"/><TextBlock x:Name="StateText" AutomationProperties.AutomationId="StateText" Text="글로벌 클라이언트 경로를 설정해주세요" FontSize="13" FontWeight="Bold" TextWrapping="Wrap"/><Border x:Name="StateBadge" Visibility="Collapsed" Margin="0,3,0,0"><TextBlock x:Name="StateBadgeText" Foreground="{StaticResource TextDim}" FontSize="11" TextWrapping="Wrap"/></Border></StackPanel>
                  <ToggleButton x:Name="PathsToggle" AutomationProperties.AutomationId="PathsToggle" Grid.Column="2" Style="{StaticResource TextToggle}" Content="경로 확인" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="11"/>
                </Grid>
                <StackPanel x:Name="PathsPanel" Visibility="Collapsed" Margin="0,12,0,0">
                  <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="글로벌" Foreground="{StaticResource TextDim}" VerticalAlignment="Center"/><Border Grid.Column="1" Background="{StaticResource Panel2Bg}" CornerRadius="5" Padding="9,6" Margin="0,0,8,0"><TextBlock x:Name="GlobalPathText" Text="(미설정)" FontFamily="Cascadia Code, Consolas" FontSize="11" TextTrimming="CharacterEllipsis"/></Border><Button x:Name="GlobalBrowseButton" Grid.Column="2" Style="{StaticResource SubButton}" Content="변경"/></Grid>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="한국" Foreground="{StaticResource TextDim}" VerticalAlignment="Center"/><Border Grid.Column="1" Background="{StaticResource Panel2Bg}" CornerRadius="5" Padding="9,6" Margin="0,0,8,0"><TextBlock x:Name="KoreaPathText" Text="(미설정)" FontFamily="Cascadia Code, Consolas" FontSize="11" TextTrimming="CharacterEllipsis"/></Border><Button x:Name="KoreaBrowseButton" Grid.Column="2" Style="{StaticResource SubButton}" Content="변경"/></Grid>
                  <StackPanel Orientation="Horizontal" Margin="52,9,0,0"><Button x:Name="DetectButton" Style="{StaticResource SubButton}" Content="자동 탐색"/><Button x:Name="ResetButton" Style="{StaticResource SubButton}" Content="경로 리셋" Margin="7,0,0,0"/></StackPanel>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="14,15,8,12">
              <StackPanel>
                <DockPanel Margin="0,0,6,0"><Border DockPanel.Dock="Right" BorderBrush="#705D3C" BorderThickness="1" CornerRadius="10" Padding="7,2" VerticalAlignment="Center"><TextBlock Text="적용 전 선택" Foreground="{StaticResource GoldBright}" FontSize="10"/></Border><StackPanel><TextBlock Text="원하는 결과를 직접 선택하세요" Foreground="{StaticResource TextDim}" FontSize="11"/><TextBlock Text="이번에 적용할 구성" FontSize="15" FontWeight="Bold"/></StackPanel></DockPanel>
                <Grid x:Name="ConfigurationControls" Margin="0,13,6,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <StackPanel x:Name="LanguagePanel" Orientation="Horizontal"><TextBlock Text="베이스 언어" Foreground="#C9D0DB" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,10,0"/><ComboBox x:Name="LanguageCombo" AutomationProperties.AutomationId="LanguageCombo" AutomationProperties.Name="베이스 언어" Style="{StaticResource DarkCombo}" Width="170" Height="33" FontSize="11.5"/></StackPanel>
                  <StackPanel x:Name="PresetPanel" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"><RadioButton x:Name="PresetFull" AutomationProperties.AutomationId="PresetFull" Style="{StaticResource Chip}" GroupName="TextProfile" Content="전체 한글"/><RadioButton x:Name="PresetCustom" AutomationProperties.AutomationId="PresetCustom" Style="{StaticResource Chip}" GroupName="TextProfile" Content="직접 설정" Margin="6,0,0,0"/></StackPanel>
                </Grid>
                <TextBlock Text="전체 한글로 전환해도 마지막 직접 설정은 보관합니다." Foreground="{StaticResource TextDim}" FontSize="11" Margin="0,8,6,12" TextWrapping="Wrap"/>
                <TextBlock Text="텍스트 8개 범위" Foreground="#C9D0DB" FontSize="10.5" Margin="0,0,0,7"/>
                <UniformGrid x:Name="TextScopeGrid" Columns="2">
                  <Border Style="{StaticResource ScopeRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0" VerticalAlignment="Center"><TextBlock Text="스토리·퀘스트 텍스트" Style="{StaticResource ScopeLabel}"/><TextBlock Text="대사·컷신·퀘스트 이름과 목표" Style="{StaticResource ScopeDescription}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><RadioButton x:Name="ScopeStoryKo" AutomationProperties.AutomationId="ScopeStoryKo" Style="{StaticResource ScopeOutcome}" GroupName="StoryOutcome" Content="한국어"/><RadioButton x:Name="ScopeStoryBase" AutomationProperties.AutomationId="ScopeStoryBase" Style="{StaticResource ScopeOutcome}" GroupName="StoryOutcome" Tag="base" Margin="3,0,0,0"/></StackPanel></Grid></Border>
                  <Border Style="{StaticResource ScopeRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0" VerticalAlignment="Center"><TextBlock Text="전투 NPC 이름" Style="{StaticResource ScopeLabel}"/><TextBlock Text="몬스터·보스 · 일반 NPC 제외" Style="{StaticResource ScopeDescription}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><RadioButton x:Name="ScopeBnpcKo" AutomationProperties.AutomationId="ScopeBnpcKo" Style="{StaticResource ScopeOutcome}" GroupName="BnpcOutcome" Content="한국어"/><RadioButton x:Name="ScopeBnpcBase" AutomationProperties.AutomationId="ScopeBnpcBase" Style="{StaticResource ScopeOutcome}" GroupName="BnpcOutcome" Tag="base" Margin="3,0,0,0"/></StackPanel></Grid></Border>
                  <Border Style="{StaticResource ScopeRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0" VerticalAlignment="Center"><TextBlock Text="기술 이름" Style="{StaticResource ScopeLabel}"/><TextBlock Text="전투·제작 등 기술 이름" Style="{StaticResource ScopeDescription}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><RadioButton x:Name="ScopeActionKo" AutomationProperties.AutomationId="ScopeActionKo" Style="{StaticResource ScopeOutcome}" GroupName="ActionOutcome" Content="한국어"/><RadioButton x:Name="ScopeActionBase" AutomationProperties.AutomationId="ScopeActionBase" Style="{StaticResource ScopeOutcome}" GroupName="ActionOutcome" Tag="base" Margin="3,0,0,0"/></StackPanel></Grid></Border>
                  <Border Style="{StaticResource ScopeRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0" VerticalAlignment="Center"><TextBlock Text="임무 이름" Style="{StaticResource ScopeLabel}"/><TextBlock Text="던전·토벌전·레이드 이름" Style="{StaticResource ScopeDescription}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><RadioButton x:Name="ScopeDutyKo" AutomationProperties.AutomationId="ScopeDutyKo" Style="{StaticResource ScopeOutcome}" GroupName="DutyOutcome" Content="한국어"/><RadioButton x:Name="ScopeDutyBase" AutomationProperties.AutomationId="ScopeDutyBase" Style="{StaticResource ScopeOutcome}" GroupName="DutyOutcome" Tag="base" Margin="3,0,0,0"/></StackPanel></Grid></Border>
                  <Border Style="{StaticResource ScopeRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0" VerticalAlignment="Center"><TextBlock Text="아이템 이름" Style="{StaticResource ScopeLabel}"/><TextBlock Text="아이템 이름 · 설명은 기타 텍스트" Style="{StaticResource ScopeDescription}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><RadioButton x:Name="ScopeItemKo" AutomationProperties.AutomationId="ScopeItemKo" Style="{StaticResource ScopeOutcome}" GroupName="ItemOutcome" Content="한국어"/><RadioButton x:Name="ScopeItemBase" AutomationProperties.AutomationId="ScopeItemBase" Style="{StaticResource ScopeOutcome}" GroupName="ItemOutcome" Tag="base" Margin="3,0,0,0"/></StackPanel></Grid></Border>
                  <Border Style="{StaticResource ScopeRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0" VerticalAlignment="Center"><TextBlock Text="지역 이름" Style="{StaticResource ScopeLabel}"/><TextBlock Text="지역·도시·세부 장소 이름" Style="{StaticResource ScopeDescription}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><RadioButton x:Name="ScopePlaceKo" AutomationProperties.AutomationId="ScopePlaceKo" Style="{StaticResource ScopeOutcome}" GroupName="PlaceOutcome" Content="한국어"/><RadioButton x:Name="ScopePlaceBase" AutomationProperties.AutomationId="ScopePlaceBase" Style="{StaticResource ScopeOutcome}" GroupName="PlaceOutcome" Tag="base" Margin="3,0,0,0"/></StackPanel></Grid></Border>
                  <Border Style="{StaticResource ScopeRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0" VerticalAlignment="Center"><TextBlock Text="자동 번역 상용구" Style="{StaticResource ScopeLabel}"/><TextBlock Text="채팅의 자동 번역 문구" Style="{StaticResource ScopeDescription}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><RadioButton x:Name="ScopeCommonKo" AutomationProperties.AutomationId="ScopeCommonKo" Style="{StaticResource ScopeOutcome}" GroupName="CommonOutcome" Content="한국어"/><RadioButton x:Name="ScopeCommonBase" AutomationProperties.AutomationId="ScopeCommonBase" Style="{StaticResource ScopeOutcome}" GroupName="CommonOutcome" Tag="base" Margin="3,0,0,0"/></StackPanel></Grid></Border>
                  <Border Style="{StaticResource ScopeRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0" VerticalAlignment="Center"><TextBlock Text="기타 게임 텍스트" Style="{StaticResource ScopeLabel}"/><TextBlock Text="메뉴·설명·일반 NPC 이름 등" Style="{StaticResource ScopeDescription}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><RadioButton x:Name="ScopeRemainderKo" AutomationProperties.AutomationId="ScopeRemainderKo" Style="{StaticResource ScopeOutcome}" GroupName="RemainderOutcome" Content="한국어"/><RadioButton x:Name="ScopeRemainderBase" AutomationProperties.AutomationId="ScopeRemainderBase" Style="{StaticResource ScopeOutcome}" GroupName="RemainderOutcome" Tag="base" Margin="3,0,0,0"/></StackPanel></Grid></Border>
                </UniformGrid>
                <Border BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,1,0,0" Padding="0,9,0,0" Margin="0,3,0,0"><Border Style="{StaticResource ScopeRow}" Background="Transparent"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBlock Text="UI 이미지" Style="{StaticResource ScopeLabel}"/><TextBlock Text="지도·지역 타이틀·로딩 등 글자가 포함된 이미지" Style="{StaticResource ScopeDescription}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><RadioButton x:Name="ScopeUiAssetsKo" AutomationProperties.AutomationId="ScopeUiAssetsKo" Style="{StaticResource ScopeOutcome}" GroupName="UiAssetsOutcome" Content="한국어"/><RadioButton x:Name="ScopeUiAssetsBase" AutomationProperties.AutomationId="ScopeUiAssetsBase" Style="{StaticResource ScopeOutcome}" GroupName="UiAssetsOutcome" Tag="base" Margin="3,0,0,0"/></StackPanel></Grid></Border></Border>
                <Border Style="{StaticResource ScopeRow}" Background="Transparent"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBlock Text="말하기 퀘스트 입력 문구" Style="{StaticResource ScopeLabel}"/><TextBlock x:Name="SayQuestDescription" Style="{StaticResource ScopeDescription}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><RadioButton x:Name="SayQuestKo" AutomationProperties.AutomationId="SayQuestKo" Style="{StaticResource ScopeOutcome}" GroupName="SayQuestOutcome" Content="한국어"/><RadioButton x:Name="SayQuestBase" AutomationProperties.AutomationId="SayQuestBase" Style="{StaticResource ScopeOutcome}" GroupName="SayQuestOutcome" Tag="base" Margin="3,0,0,0"/></StackPanel></Grid></Border>
